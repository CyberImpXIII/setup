#!/usr/bin/env python3
"""setup: bring a git repo (or a new folder) to the shared baseline.

  setup <path> [--dry-run] [--github [--private] [--owner O]] [--name N] [--hooks-from DIR]
               [--plugins FILE] [--user-scope FILE] [--relative-to DIR] [--checks CLI] [--data-repo DIR]
               [--only COMPONENT] [--no-commit] [--json]
      install every component in components.json; one line each, then a result line.
      --only COMPONENT: run that one component alone (a name `setup components`
      lists), on an existing repo only (a new folder is refused: nothing else
      would create the repo), never with --node; e.g. --only hooks installs the
      hook copies and libraries and touches nothing else.
      A repo setup creates gets .claude/settings.json (the render a proposal would
      hold), committed; an existing repo only ever gets settings.proposed.json.
      In an existing repo the run commits what it rendered, in the same run
      ("setup: render N file(s) into <name>", exactly those files), or refuses
      (exit 2, nothing written) when it would render into a tree with changes
      git does not hold; settings.json rides in that commit only when it equals
      settings.proposed.json byte for byte. A commit the repo's own git
      hooks refuse leaves the render written and unstaged for its owner to
      check and commit (the commit line needs-owner).
      --no-commit: an existing repo only, never with --node: the render is
      written and NOT committed, and the commit line (needs-owner) names every
      path written, so the owner checks and commits it with its own work in one
      commit (a repo whose pre-commit wants the render and whose tree holds
      that work). A tree with changes is let through; refused (exit 2, nothing
      written) when a path the run would write holds changes git does not.
      The roster line's dir is <path> relative to DIR (default: the working
      folder), normalised; null when <path> is not under DIR. --plugins: a
      plug-in hook registry (JSON: root, ok, plugins[name, applies_to, faults,
      registration]); the registrations that apply to <path> join the settings
      proposal. Without it, no plug-in is proposed, and the hooks line says so.
      --user-scope: the hook copies report (JSON with user_scope{exists, error,
      hooks[file, kind, test, registered]}); a shared hook the user settings
      already run is not copied, and the proposal does not register it per
      repo ("covered by user scope: <files>"). Without it, nothing is covered.
      --checks CLI: the shared checks, run last, once everything is rendered
      (`CLI run <path>`, then each contract gate it left out by name, in
      sequence; never in a dry run): their result is the gates line, and a
      contract gate the CLI lacks fails it. Without it, the gates line is none.
      --data-repo DIR: the data repo's root (default: $DATA_REPO): a repo whose
      cli.json declares import and verify and whose store is absent gets
      `<cli> import` then `<cli> verify --json`, with DATA_REPO set to it. Unset,
      the data line is needs-jacob and no store is made.
      Every hook file that differed from the source gets a line of its own:
      hooks <action> <file> (<kind>), kind missing, header-only, logic, bytes or
      mode (`setup components`). A logic, bytes or mode difference is drift, kept.
  setup <path> --rebuild [--overwrite-uncommitted] [--only hooks|parts|mutate] [--dry-run] [...]
      the same run, but a hook copy whose logic drifted from the source is
      overwritten from it (in any repo, created by setup or not), and its line says
      `rewritten`. Only files the hooks listing renders into a folder directly
      under .claude/ (the hooks and their libraries), and the runner copies
      (devtools/parts.py, devtools/mutate.py: "--rebuild rewrote"); never settings.json,
      .githooks/ or anything setup does not render. Refused (exit 2, nothing written) while one of those copies has
      changes git does not hold (uncommitted, untracked or ignored), unless
      --overwrite-uncommitted. The rewrite is committed in the same run, like
      every render. Per repo: setup <repo> --only hooks --rebuild
      (or --only parts --rebuild, --only mutate --rebuild for one runner alone)
  setup <path> --node [--rebuild] [...]
      also set up each child <path>/node.json lists (created as a repo nested in
      this one when absent; a child with its own node.json recurses; never
      --github). node.json is the shared checks' shape: rebuild, generated,
      record, children, registry. --rebuild renders every generated file again
      in place and prints one line per file: regenerated, drift (the render is
      written: git diff is the finding), record, unaccounted, failed. It never
      writes a record or a generated file with uncommitted changes, and the
      component lines are a dry run's. Only failed exits 1: drift and unaccounted are
      the progress to make (the checks' `regenerate` is the gate). Run it on a
      copy: --dry-run writes nothing.
  setup fanout <component> [--repos PATH...] [--root DIR] [--rebuild] [--hooks-from DIR]
               [--agent NAME] [--check-timeout S] [--dry-run] [--json]
      one shared change into every repo that declares the component (components.json
      `fanout`: rules, hooks, parts), each git work tree under DIR (default: the
      working folder) or each --repos PATH; one after another, each step its own
      process. Per repo: `setup <repo> --only <component> --dry-run` (a copy it
      would keep as drift, or a refusal: failed, nothing written; nothing to
      render: unchanged, no check, no commit), a clean tree (else failed), the
      render (--no-commit), the repo's `./dev.sh check`, then a commit of exactly
      the rendered files whose message names the source commit (the source's HEAD;
      refused, exit 2, while what it renders from holds uncommitted changes). A red
      check, a commit the repo's git hooks refuse: failed, the render left written
      and uncommitted, its paths named. --rebuild (off by default) is passed to
      setup: a drifted hook or runner copy is overwritten. --agent NAME adds an
      `Agent: NAME` trailer (a repo's commit-msg hook asks for one in a session).
      --dry-run stops before writing: would-commit. One line per repo (committed,
      unchanged, would-commit, undeclared: a --repos path the component is not
      for, failed), then a summary. Exit 1 when any repo failed; 2 on a usage
      error or a source that cannot be named.
  setup components            what each component installs, and the status vocabulary
  setup plans <dir> [--steps [--todo CLI] [--cited-in FILE]... [--json] | --facts [--root DIR] [--json]]
      every PLAN-*.md there that is not done has a "Setup component" heading,
      and in every plan each section status marker is valid and placed, and no section
      number is carried twice; the last line is `ok ... N sections: a open, b approved,
      c done, d unstated` (the sections of the plans not done), or the FAIL lines.
      Before it, a `note  steps: N steps, k unplaceable (...)` line: G2's failing
      rule is held (PLAN-services §3), so an unplaceable step is counted, never a
      failure. In each plan not done, the `## Research` id rules (setuplib/rsids.py,
      PLAN-services §3 R1, R6): a `## Research` line starting `rs-` is `rs-<n> --
      <question>`, each id listed once; every `rs-<n>` cited is listed there; every
      id cited resolves (`<research cli> get <id> --json`, dependencies.json); one
      cited under `## Decisions` is answered at full depth (open or quick: FAIL).
      With ids cited, a `note  research:` line counts them; no research CLI (a lone
      clone): `UNCHECKED research: ...`, exit 3, never ok. --steps instead reports each step of each plan not done, one line
      `<status> <file> §<s> step <n>  <detail>`: open, closed, needs-yes,
      superseded, untracked (an owner, no tag), dangling (the tag does not
      resolve), unchecked (could not look it up: a store item without --todo, or
      `CLI -C <repo> get <id>` failing), unplaceable, group. --cited-in FILE checks
      each `PLAN-*.md §<s> [step <n>]` citation in FILE: ok, dangling or ambiguous.
      The last line counts them. Exit 0 whatever it finds; 2 if FILE is unreadable.
      --facts [--root DIR] [--json] instead re-derives the plans' facts:
      each fact cited as `<cmd>` → <value> in a plan not done (PLAN-architecture
      §12 item 3) is re-run and compared: the command must be one argv (no pipe,
      redirect or substitution) naming a CLI exactly one cli.json under DIR
      (default: <dir>) declares, and a verb in that cli.json's read.verbs; it runs
      from <dir>, without a shell, and its stripped stdout must equal <value>.
      One line per fact not the same: changed, failed, not-declared,
      not-one-command, ambiguous; the last line counts them and the
      `(read by hand, <date>)` marks. Exit 0 when every fact is the same, 1
      otherwise, 2 when <dir> or DIR is not a folder (setuplib/facts.py).
  setup plans steps <file> [--json]
      the steps of one plan, as the one parser reads G1's grammar (setuplib/steps.py):
      a numbered item under a heading starting Steps, Phase or Handoff (or nested in
      one), `` `owner`: `` at its start, at most one `track: <form>` ending it.
      A section is a numbered heading (`## 3. Title`, `### 7.12 Title`, `## 2a. Title`)
      through the line before the next heading of its level or above, trailing blank
      lines dropped. Its status is a marker on the first non-blank line under it:
      <!-- status: open|approved|done -->
      none is unstated.
  setup plans show <file> §<n>
      prints that section, exactly, on stdout; on stderr `digest <sha256 hex>` of the
      file's bytes (what edit's --digest takes). A missing file, a missing or
      ambiguous section: exit 1, `plans show: <why>` on stderr, nothing on stdout.
  setup plans list <dir> [--all]
      one line per section: `<file> §<n> <status>  <title>`; without --all, a done
      plan, a done section and the sections inside one are left out.
  setup plans edit <file> §<n> --from <src> --digest <sha256> [--dry-run]
      replaces exactly that section of a PLAN-*.md with <src> (which starts with the
      same numbered heading at the same level and adds no section); every other byte
      is kept. Refused, exit 1, nothing written, when the file's digest is not
      <sha256> (it changed since it was shown), when `setup plans <its dir>` is red
      before or would be red after. Prints `plans edit: <file> §<n> replaced (lines
      A-B now A-C); digest <new sha256>`.
  setup plans add <file> --after §<n> --from <src> --digest <sha256> [--dry-run]
      inserts <src>, one new section, after §<n> and everything under it, with one
      blank line before it; every other byte is kept. <src> starts with a numbered
      heading at §<n>'s level whose number no heading in the file carries, and adds
      no other section at that level or above. Refused as edit is (the digest, the
      gate before and after, nothing written). Prints `plans add: <file> §<m> added
      after §<n> (lines A-B); digest <new sha256>`.
  setup audit content         setup names no repo, repo path or repo command
  setup audit direction       setup reads nothing of the delegation layer
  setup audit deps            each tool dependencies.json names (installed FROM) is a discovered repo

Exit: 0 when nothing failed or drifted (needs-* lines are not failures), 1 on
drift or a failure, 2 when the path is refused or the usage is wrong; a refused
path has had nothing written. `audit content` and `audit deps` exit 3 when they could not run
(no sibling repos to compare against, as in a lone clone): UNCHECKED, never a
pass. A path named like a subcommand: pass ./<name>.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from setuplib import audit, core, facts, fanout, fsw, plans, rsids, steps  # noqa: E402

SUBCOMMANDS = ["components", "plans", "audit", "fanout"]


def cmd_components(_):
    spec = core.load_spec()
    for c in spec["components"]:
        print(f"  {c['name']:<8} {c['installs']}")
    print("one alone, on an existing repo: setup <path> --only <component>")
    print("statuses:")
    for k, v in spec["statuses"].items():
        print(f"  {k:<13} {v}")
    print("rebuild statuses (--node --rebuild, one line per file):")
    for k, v in spec["rebuild_statuses"].items():
        print(f"  {k:<13} {v}")
    hr = next(c for c in spec["components"] if c["name"] == "hooks")["rebuild"]
    print(f"hook files (one line per file that differed; --rebuild without --node overwrites only "
          f"a file the listing renders into a folder directly under {hr['scope_root']}/):")
    for part in ("kinds", "actions"):
        print(f"  {part}:")
        for k, v in hr[part].items():
            print(f"    {k:<12} {v}")
    fo = spec["fanout"]
    print("fanout (setup fanout <component>; a repo declares it by holding the file):")
    for name, d in fo["declared_by"].items():
        print(f"  {name:<8} {d['file']}" + (f" holding {d['contains']}" if "contains" in d else ""))
    print("fanout statuses (one line per repo):")
    for k, v in fo["statuses"].items():
        print(f"  {k:<13} {v}")
    return 0


PLANS_USAGE = {
    "": "setup plans <dir> [--steps [--todo CLI] [--cited-in FILE]... [--json] | --facts [--root DIR] [--json]]",
    "show": "setup plans show <file> §<n>",
    "list": "setup plans list <dir> [--all]",
    "steps": "setup plans steps <file> [--json]",
    "edit": "setup plans edit <file> §<n> --from <src> --digest <sha256> [--dry-run]",
    "add": "setup plans add <file> --after §<n> --from <src> --digest <sha256> [--dry-run]",
}


def cmd_plans(args):
    action = args[0] if args and args[0] in PLANS_USAGE else ""
    rest = args[1:] if action else args
    return {"": plans_gate, "show": plans_show, "list": plans_list, "steps": plans_steps,
            "edit": plans_edit, "add": plans_add}[action](rest)


def _live_plans(folder, instead=None):
    """[(path, text)] for each PLAN-*.md in folder whose own status is not done;
    `instead` ({file name: text}) as in audit.audit_plans."""
    out, instead = [], instead or {}
    for p in sorted(Path(folder).glob("PLAN-*.md")):
        text = instead[p.name] if p.name in instead else p.read_text()
        if not audit.plan_findings(p.name, text)[1]:
            out.append((p, text))
    return out


def _plans_findings(folder, instead=None):
    """(findings, note, research note, unchecked) of the plans gate over folder:
    audit.audit_plans, then the `## Research` id rules (setuplib/rsids.py) over the
    plans not done. The research note is None when no plan cites an id; unchecked
    names why ids could not be resolved (no research CLI), else None."""
    findings, note = audit.audit_plans(folder, instead)
    named = [(p.name, t) for p, t in _live_plans(folder, instead)]
    if not any(rsids.ID_RX.search(t) for _, t in named):
        return findings, note, None, None
    cli, why = rsids.service_cli()
    found, unresolved, count = rsids.findings(named, cli)
    rnote = (f"{count} citation(s) of rs- ids in {sum(1 for _, t in named if rsids.ID_RX.search(t))} "
             f"plan(s), " + (f"resolved with {cli}" if cli else "not resolved"))
    unchecked = (f"{len(unresolved)} id(s) cited ({', '.join(unresolved[:5])}"
                 f"{', ...' if len(unresolved) > 5 else ''}), none resolved: {why}") if unresolved else None
    return findings + found, note, rnote, unchecked


def _cite(s):
    return f"{s['file']} §{s['section'] or '-'} step {s['step']}"


def plans_gate(args):
    p = argparse.ArgumentParser(prog="setup plans", add_help=False)
    p.add_argument("dir")
    p.add_argument("--steps", action="store_true")
    p.add_argument("--todo")
    p.add_argument("--cited-in", action="append", default=[])
    p.add_argument("--json", action="store_true")
    p.add_argument("--facts", action="store_true")
    p.add_argument("--root")
    try:
        a = p.parse_args(args)
    except SystemExit:
        a = None
    if a is None or ((a.todo or a.cited_in) and not a.steps) or (a.json and not (a.steps or a.facts)) \
            or (a.steps and a.facts) or (a.root and not a.facts):
        print(f"usage: {PLANS_USAGE['']}", file=sys.stderr)
        return 2
    if a.facts:
        return facts_report(Path(a.dir), Path(a.root) if a.root else Path(a.dir), a.json)
    if a.steps:
        return steps_report(Path(a.dir), a.todo, a.cited_in, a.json)
    findings, note, rnote, unchecked = _plans_findings(Path(a.dir))
    if Path(a.dir).is_dir():  # G2's failing rule is held: the unplaceable steps are counted, never a failure
        found = [s for path, text in _live_plans(a.dir) for s in steps.parse(path.name, text)]
        bad = [_cite(s) for s in found if not s["placeable"]]
        first = f" ({', '.join(bad[:5])}{', ...' if len(bad) > 5 else ''})" if bad else ""
        print(f"  note  steps: {len(found)} steps, {len(bad)} unplaceable{first}; `setup plans {a.dir} --steps` "
              "lists them (G2's failing rule is held: never a failure)")
    if rnote:
        print(f"  note  research: {rnote}")
    for f in findings:
        print(f"  FAIL  {f}")
    if unchecked:  # never a pass: the ids are cited and nothing could say whether they resolve
        print(f"  UNCHECKED  research: {unchecked}")
    if not findings and not unchecked:  # the ok line stays last: a caller reads the last line
        print(f"  ok    {note}: every plan not done has a Setup component heading")
    return 1 if findings else 3 if unchecked else 0


def facts_report(folder, root, as_json):
    """`setup plans <dir> --facts` (PLAN-architecture §12 item 3): each
    `` `<cmd>` → <value> `` in each plan not done, re-run when the command is a
    declared read verb of a cli.json under `root` (default: the folder), and its
    value compared. Exit 0 when every fact is the same; 1 when one changed, could
    not be re-run, or cites a command that is not a declared read verb; 2 when the
    folder or the root is not a folder."""
    for what, d in (("the folder", folder), ("--root", root)):
        if not d.is_dir():
            print(f"plans --facts: {what} {d} is not a folder", file=sys.stderr)
            return 2
    clis, bad = facts.declared(root)
    rows, by_hand = [], 0
    for path, text in _live_plans(folder):
        found, marks = facts.parse(path.name, text)
        by_hand += marks
        rows += [facts.check(f, folder, clis) for f in found]
    counts = {k: sum(r["status"] == k for r in rows) for k in facts.STATUSES}
    unreadable = [{"path": p, "why": w} for p, w in bad]
    if as_json:
        print(json.dumps({"facts": rows, "counts": counts, "by_hand": by_hand, "unreadable_cli_json": unreadable}))
    else:
        for r in rows:
            if r["status"] != "same":
                print(f"{r['status']:<16} {r['doc']}:{r['line']}  `{r['cmd']}`  {r['why']}")
        for u in unreadable:
            print(f"note             {u['path']}: not read ({u['why']})")
        summary = ", ".join(f"{v} {k}" for k, v in counts.items() if v)
        print(f"facts: {len(rows)} cited ({summary or 'none'}); {by_hand} read by hand")
    return 1 if any(r["status"] != "same" for r in rows) else 0


def steps_report(folder, todo_cli, cited_in, as_json):
    """`setup plans <dir> --steps`: each step of each plan not done, with what its
    track tag resolves to (G5), and each plan citation in the --cited-in files
    checked (the reverse check). A report: exit 0 whatever it finds (G2 is held);
    2 when the folder or a cited file cannot be read."""
    if not folder.is_dir():
        print(f"plans --steps: {folder} is not a folder", file=sys.stderr)
        return 2
    texts = []
    for f in cited_in:
        try:
            texts.append((f, Path(f).read_text()))
        except (OSError, UnicodeDecodeError) as e:
            print(f"plans --steps: --cited-in {f}: cannot be read ({getattr(e, 'strerror', None) or e})",
                  file=sys.stderr)
            return 2
    rows = []
    for path, text in _live_plans(folder):
        for s in steps.parse(path.name, text):
            status, detail = steps.resolve(s, folder, todo_cli)
            rows.append({**s, "status": status, "detail": detail})
    cites, cache = [], {}
    for f, text in texts:
        for c in steps.citations(f, text):
            status, why = steps.check_citation(c, folder, cache)
            cites.append({**c, "status": status, "why": why})
    counts = {k: sum(r["status"] == k for r in rows) for k in steps.STATUSES}
    ccounts = {k: sum(c["status"] == k for c in cites) for k in steps.CITE_STATUSES}
    if as_json:
        print(json.dumps({"steps": rows, "counts": counts, "citations": cites, "citation_counts": ccounts}))
        return 0
    for r in rows:
        print(f"  {r['status']:<11} {_cite(r)}  {r['detail'] or ''}".rstrip())
    for c in cites:
        ref = f"{c['plan']} §{c['section']}" + (f" step {c['step']}" if c["step"] else "")
        print(f"  {c['status']:<11} {c['source']}:{c['line']}  {ref}  {c['why'] or ''}".rstrip())
    by = ", ".join(f"{n} {k}" for k, n in counts.items() if n)
    cby = ", ".join(f"{n} {k}" for k, n in ccounts.items() if n)
    print(f"steps: {len(rows)} steps{': ' + by if by else ''}; {len(cites)} citation(s){': ' + cby if cby else ''}; "
          "a report, never a failure (G2's failing rule is held)")
    return 0


def plans_steps(args):
    if not args or len(args) > 2 or (len(args) == 2 and args[1] != "--json"):
        print(f"usage: {PLANS_USAGE['steps']}", file=sys.stderr)
        return 2
    _, text, why = _read_plan(args[0])
    if why:
        print(f"plans steps: {why}", file=sys.stderr)
        return 1
    name = Path(args[0]).name
    got = steps.parse(name, text)
    if len(args) == 2:
        print(json.dumps(got))
        return 0
    for s in got:
        state = "group" if s["children"] else "placeable" if s["placeable"] else "unplaceable"
        track = s["track"]["value"] if s["track"] else "-"
        why = f"  ({s['why']})" if s["why"] else ""
        print(f"  {state:<11} {_cite(s)}  line {s['line']}  owners {', '.join(s['owners']) or '-'}  "
              f"track {track}{why}")
    print(f"{name}: {len(got)} steps, {sum(not s['placeable'] for s in got)} unplaceable")
    return 0


def _read_plan(path):
    """(bytes, text, None) or (None, None, why): text is the bytes decoded, line ends
    kept as they are (read_text would turn CRLF into LF, and an edit must keep every
    byte outside its section)."""
    try:
        raw = Path(path).read_bytes()
        return raw, raw.decode("utf-8"), None
    except (OSError, UnicodeDecodeError) as e:
        return None, None, f"{path}: cannot be read ({getattr(e, 'strerror', None) or e})"


def plans_show(args):
    if len(args) != 2:
        print(f"usage: {PLANS_USAGE['show']}", file=sys.stderr)
        return 2
    raw, text, why = _read_plan(args[0])
    if not why:
        out, why = plans.section_text(Path(args[0]).name, text, args[1])
    if why:
        print(f"plans show: {why}", file=sys.stderr)
        return 1
    print(out)  # stdout: the section, exactly
    print(f"digest {plans.digest(raw)}", file=sys.stderr)  # what `plans edit --digest` takes
    return 0


def plans_list(args):
    every = "--all" in args
    rest = [a for a in args if a != "--all"]
    if len(rest) != 1 or not Path(rest[0]).is_dir():
        print(f"usage: {PLANS_USAGE['list']}", file=sys.stderr)
        return 2
    for p in sorted(Path(rest[0]).glob("PLAN-*.md")):
        _, is_done, secs = audit.plan_findings(p.name, p.read_text())
        if is_done and not every:
            continue
        for s in plans.live(secs, every):
            print(f"{p.name} §{s['number']} {s['status'] or 'unstated'}  {s['title']}")
    return 0


def _plan_args(action, ref_flag=None):
    """The parser `plans edit` and `plans add` share: <file>, the section (a positional,
    or `ref_flag`), --from, --digest, --dry-run."""
    p = argparse.ArgumentParser(prog=f"setup plans {action}", add_help=False)
    p.add_argument("file")
    p.add_argument(ref_flag, dest="ref", required=True) if ref_flag else p.add_argument("ref")
    p.add_argument("--from", dest="src", required=True)
    p.add_argument("--digest", required=True)
    p.add_argument("--dry-run", action="store_true")
    return p


def _guarded_plan_write(action, a, change):
    """The one guarded write of a plan file (`plans edit`, `plans add`): refused,
    exit 1, nothing written, when the file is not a PLAN-*.md, its digest is not
    --digest (it changed since it was shown; checked again just before the write),
    <src> cannot be read, `setup plans <its dir>` is red before, `change` refuses,
    or the gate would be red after. change(name, text, new) -> ((out, line), None)
    or (None, why); `line` is what the success line says was done."""
    plan = Path(a.file)
    name, folder = plan.name, plan.parent

    def refuse(why):
        print(f"plans {action}: refused, nothing written: {why}", file=sys.stderr)
        return 1

    if not (name.startswith("PLAN-") and name.endswith(".md")):
        return refuse(f"{name} is not a plan (PLAN-*.md): the gate it runs is `setup plans <dir>`")
    def stale():
        """Why the file is not the one the caller read (its digest), or None. Run at
        the start and again just before the write, as the gate takes a while."""
        raw_now, _, why = _read_plan(plan)
        if why:
            return why
        now = plans.digest(raw_now)
        return None if now == a.digest else (
            f"{name} changed since digest {a.digest[:12]}... (now {now[:12]}...): "
            "show the section again and redo the change on what is there now")

    raw, text, why = _read_plan(plan)
    why = why or stale()
    if why:
        return refuse(why)
    try:
        new = Path(a.src).read_text()
    except (OSError, UnicodeDecodeError) as e:
        return refuse(f"{a.src}: cannot be read ({getattr(e, 'strerror', None) or e})")
    before, _, _, unchecked = _plans_findings(folder)
    if before:
        return refuse(f"`setup plans {folder}` is already red ({len(before)} finding(s)), first: {before[0]}")
    if unchecked:
        return refuse(f"`setup plans {folder}` is not green: UNCHECKED research: {unchecked}")
    done, why = change(name, text, new)
    if why:
        return refuse(why)
    out, line = done
    after, _, _, unchecked = _plans_findings(folder, {name: out})
    if after:
        return refuse(f"the {action} would turn `setup plans {folder}` red, first: {after[0]}")
    if unchecked:
        return refuse(f"after the {action}, `setup plans {folder}` would not be green: UNCHECKED research: {unchecked}")
    why = stale()
    if why:
        return refuse(why)
    fsw.Writer(folder, a.dry_run).write(name, out)
    print(f"plans {action}: {name} {line(a.dry_run)}; "
          f"digest {plans.digest(out.encode()) if not a.dry_run else a.digest}")
    return 0


def plans_edit(args):
    try:
        a = _plan_args("edit").parse_args(args)
    except SystemExit:
        print(f"usage: {PLANS_USAGE['edit']}", file=sys.stderr)
        return 2

    def change(name, text, new):
        done, why = plans.replace(name, text, a.ref, new)
        if why:
            return None, why
        out, (first, old_last, new_last) = done
        return (out, lambda dry: f"§{a.ref.lstrip('§')} {'would be replaced' if dry else 'replaced'} "
                                 f"(lines {first}-{old_last} now {first}-{new_last})"), None
    return _guarded_plan_write("edit", a, change)


def plans_add(args):
    try:
        a = _plan_args("add", "--after").parse_args(args)
    except SystemExit:
        print(f"usage: {PLANS_USAGE['add']}", file=sys.stderr)
        return 2

    def change(name, text, new):
        done, why = plans.insert(name, text, a.ref, new)
        if why:
            return None, why
        out, (num, first, last) = done
        return (out, lambda dry: f"§{num} {'would be added' if dry else 'added'} after §{a.ref.lstrip('§')} "
                                 f"(lines {first}-{last})"), None
    return _guarded_plan_write("add", a, change)


def cmd_audit(args):
    if args not in (["content"], ["direction"], ["deps"]):
        print("usage: setup audit content|direction|deps", file=sys.stderr)
        return 2
    fn = {"content": audit.audit_content, "direction": audit.audit_direction, "deps": audit.audit_deps}[args[0]]
    findings, note = fn()
    for f in findings:
        print(f"  FAIL  {f}")
    if findings:
        return 1
    if note.startswith("UNCHECKED"):
        print(f"  {note}")
        return 3  # could not run: never a pass
    print(f"  ok    {args[0]}: {note}")
    return 0


def cmd_fanout(argv):
    p = argparse.ArgumentParser(prog="setup fanout", add_help=False)
    p.add_argument("component")
    p.add_argument("--repos", nargs="+")
    p.add_argument("--root")
    p.add_argument("--rebuild", action="store_true")
    p.add_argument("--hooks-from")
    p.add_argument("--agent")
    p.add_argument("--check-timeout", type=int)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--json", action="store_true")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return 2
    root = Path(a.root or ".").resolve()
    if not root.is_dir():
        print(f"setup fanout: --root {a.root} is not a folder", file=sys.stderr)
        return 2
    opts = {"rebuild": a.rebuild, "dry_run": a.dry_run, "agent": a.agent,
            "hooks_from": Path(a.hooks_from).resolve() if a.hooks_from else None,
            "check_timeout": a.check_timeout or fanout.spec()["check_timeout"]}
    try:
        doc = fanout.run(a.component, a.repos, root, opts)
    except fanout.Usage as e:
        print(f"setup fanout: {e}", file=sys.stderr)
        return 2
    if a.json:
        print(json.dumps(doc))
    else:
        for r in doc["repos"]:
            print(f"  {r['status']:<12} {r['path']}  {r['detail']}")
        counts = {}
        for r in doc["repos"]:
            counts[r["status"]] = counts.get(r["status"], 0) + 1
        failed = [r["path"] for r in doc["repos"] if r["status"] == "failed"]
        summary = ", ".join(f"{n} {k}" for k, n in sorted(counts.items())) or "no repo declares it"
        print(f"setup fanout {a.component} from {doc['source']['path']}@{doc['source']['commit'][:12]}"
              f"{' (dry run, nothing written)' if a.dry_run else ''}: {summary}"
              + (f"; {doc['undeclared']} other repo(s) do not declare it" if doc["undeclared"] else "")
              + (f"; failed: {', '.join(failed)}" if failed else ""))
    return 0 if doc["ok"] else 1


def cmd_setup(argv):
    p = argparse.ArgumentParser(prog="setup", add_help=False)
    p.add_argument("path")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--github", action="store_true")
    p.add_argument("--private", action="store_true")
    p.add_argument("--owner")
    p.add_argument("--name")
    p.add_argument("--hooks-from")
    p.add_argument("--plugins")
    p.add_argument("--user-scope")
    p.add_argument("--relative-to")
    p.add_argument("--checks")
    p.add_argument("--data-repo")
    p.add_argument("--node", action="store_true")
    p.add_argument("--rebuild", action="store_true")
    p.add_argument("--overwrite-uncommitted", action="store_true")
    p.add_argument("--only")
    p.add_argument("--no-commit", action="store_true")
    p.add_argument("--json", action="store_true")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return 2
    names = [c["name"] for c in core.load_spec()["components"]]
    if a.only is not None and a.only not in names:
        print(f"setup: --only {a.only}: not a component (one of: {', '.join(names)})", file=sys.stderr)
        return 2
    if a.only and a.node:
        print("setup: --only runs one component of one repo: not with --node", file=sys.stderr)
        return 2
    if a.no_commit and a.node:
        print("setup: --no-commit leaves one repo's render uncommitted: not with --node", file=sys.stderr)
        return 2
    if a.private and not a.github:
        print("setup: --private only means something with --github", file=sys.stderr)
        return 2
    hooks_rebuild = a.rebuild and not a.node  # without --node, --rebuild overwrites drifted hook and runner copies
    if hooks_rebuild and a.only not in (None, "hooks", *core.runners(core.load_spec())):
        print(f"setup: --rebuild without --node overwrites drifted hook and runner copies: --only {a.only} "
              "renders none", file=sys.stderr)
        return 2
    if a.overwrite_uncommitted and not hooks_rebuild:
        print("setup: --overwrite-uncommitted only means something with --rebuild, without --node", file=sys.stderr)
        return 2
    rebuild_dry = a.dry_run
    if a.rebuild and a.node:
        a.dry_run = True  # a node rebuild writes only the generated files: the setup lines are a dry run's
    cwd = Path.cwd()
    dir_base = cwd / (a.relative_to or ".")
    if not dir_base.is_dir():
        print(f"setup: --relative-to {a.relative_to} is not a folder", file=sys.stderr)
        return 2
    target = (cwd / a.path).resolve()
    try:
        label = str(target.relative_to(cwd.resolve())) or "."
    except ValueError:
        label = str(target)
    s = core.Setup(target, label=label, name=a.name or target.name, dry_run=a.dry_run,
                   github=a.github, private=a.private, owner=a.owner,
                   hooks_from=a.hooks_from, plugins_from=a.plugins, user_scope_from=a.user_scope,
                   dir_base=dir_base, gh=os.environ.get("SETUP_GH", "gh"),
                   node=a.node, rebuild=a.rebuild and a.node, rebuild_dry=rebuild_dry, checks_cli=a.checks,
                   data_repo=data_repo(a.data_repo, cwd), only=a.only,
                   hooks_rebuild=hooks_rebuild, overwrite_uncommitted=a.overwrite_uncommitted,
                   no_commit=a.no_commit)
    try:
        results = s.run()
    except core.Refused as e:
        print(f"setup: refused: {e}. Nothing was written.", file=sys.stderr)
        return 2
    counts = {}
    for r in results:
        counts[r.status] = counts.get(r.status, 0) + 1
    doc = core.tree_doc(label, results, s)
    if a.json:
        print(json.dumps({"dry_run": a.dry_run, **doc}))
    else:
        print_doc(doc, "")
        summary = ", ".join(f"{counts[k]} {k}" for k in core.PRECEDENCE if k in counts)
        how = (" (dry run, nothing written)" if rebuild_dry else
               " (rebuild: only generated files written)" if a.rebuild and a.node else
               " (rebuild: drifted copies overwritten)" if hooks_rebuild else "")
        print(f"setup {label}{how}: {summary}")
    return 0 if doc["ok"] else 1


def data_repo(flag, cwd):
    """The data repo's root: --data-repo, else $DATA_REPO (the instance's loader
    exports it; setup reads no instance file), resolved against the working folder.
    None when neither is set (an empty value is unset)."""
    key = next(c["key"] for c in core.load_spec()["components"] if c["name"] == "data")
    value = flag or os.environ.get(key) or None
    return (cwd / value).resolve() if value else None


def print_doc(doc, pad):
    for r in doc["results"]:
        print(f"{pad}  {r['component']:<8} {r['status']:<13} {r['detail']}")
    for x in doc.get("rebuild", []):
        print(f"{pad}    {x['status']:<12} {x['path']}  {x['detail']}")
    lines = doc.get("hook_files", [])
    missing = [x for x in lines if x["kind"] == "missing" and x["action"] == "installed"]
    if len(missing) > 3:  # a new repo's whole render: one line, not one per file (--json lists each)
        print(f"{pad}    hooks installed  {len(missing)} files (missing){'; dry run, not written' if missing[0]['detail'] else ''}"
              " (--json lists each)")
        lines = [x for x in lines if x not in missing]
    for x in lines:
        detail = f": {x['detail']}" if x["detail"] else ""
        print(f"{pad}    hooks {x['action']:<10} {x['path']}  ({x['kind']}{detail})")
    for kid in doc.get("children", []):
        print(f"{pad}  child {kid['path']}: {'ok' if kid['ok'] else 'FAILED or drifted'}")
        print_doc(kid, pad + "    ")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] in SUBCOMMANDS:
        return globals()["cmd_" + argv[0]](argv[1:])
    return cmd_setup(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
