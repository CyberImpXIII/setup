#!/usr/bin/env python3
"""setup: bring a git repo (or a new folder) to the shared baseline.

  setup <path> [--dry-run] [--github [--private] [--owner O]] [--name N] [--hooks-from DIR]
               [--plugins FILE] [--user-scope FILE] [--relative-to DIR] [--checks CLI] [--data-repo DIR]
               [--only COMPONENT] [--json]
      install every component in components.json; one line each, then a result line.
      --only COMPONENT: run that one component alone (a name `setup components`
      lists), on an existing repo only (a new folder is refused: nothing else
      would create the repo), never with --node; e.g. --only hooks installs the
      hook copies and libraries and touches nothing else.
      A repo setup creates gets .claude/settings.json (the render a proposal would
      hold), committed; an existing repo only ever gets settings.proposed.json.
      The roster line's dir is <path> relative to DIR (default: the working
      folder), normalised; null when <path> is not under DIR. --plugins: a
      plug-in hook registry (JSON: root, ok, plugins[name, applies_to, faults,
      registration]); the registrations that apply to <path> join the settings
      proposal. Without it, no plug-in is proposed, and the hooks line says so.
      --user-scope: the hook copies report (JSON with user_scope{exists, error,
      hooks[file, kind, test, registered]}); a shared hook the user settings
      already run is not copied, and the proposal does not register it per
      repo ("covered by user scope: <files>"). Without it, nothing is covered.
      --checks CLI: the shared checks, run last, once everything is rendered
      (`CLI run <path>`, then each contract gate it left out by name, in
      sequence; never in a dry run): their result is the gates line, and a
      contract gate the CLI lacks fails it. Without it, the gates line is none.
      --data-repo DIR: the data repo's root (default: $DATA_REPO): a repo whose
      cli.json declares import and verify and whose store is absent gets
      `<cli> import` then `<cli> verify --json`, with DATA_REPO set to it. Unset,
      the data line is needs-jacob and no store is made.
      Every hook file that differed from the source gets a line of its own:
      hooks <action> <file> (<kind>), kind missing, header-only, logic, bytes or
      mode (`setup components`). A logic, bytes or mode difference is drift, kept.
  setup <path> --rebuild [--overwrite-uncommitted] [--only hooks] [--dry-run] [...]
      the same run, but a hook copy whose logic drifted from the source is
      overwritten from it (in any repo, created by setup or not), and its line says
      `rewritten`. Only files the hooks listing renders into a folder directly
      under .claude/ (the hooks and their libraries); never settings.json,
      .githooks/ or anything setup does not render. Refused (exit 2, nothing written) while one of those copies has
      changes git does not hold (uncommitted, untracked or ignored), unless
      --overwrite-uncommitted. Setup never commits here: the owner reviews
      `git diff` and commits. Per repo: setup <repo> --only hooks --rebuild
  setup <path> --node [--rebuild] [...]
      also set up each child <path>/node.json lists (created as a repo nested in
      this one when absent; a child with its own node.json recurses; never
      --github). node.json is the shared checks' shape: rebuild, generated,
      record, children, registry. --rebuild renders every generated file again
      in place and prints one line per file: regenerated, drift (the render is
      written: git diff is the finding), record, unaccounted, failed. It never
      writes a record or a generated file with uncommitted changes, and the
      component lines are a dry run's. Only failed exits 1: drift and unaccounted are
      the progress to make (the checks' `regenerate` is the gate). Run it on a
      copy: --dry-run writes nothing.
  setup components            what each component installs, and the status vocabulary
  setup plans <dir>           every PLAN-*.md there that is not done has a "Setup component" heading
  setup audit content         setup names no repo, repo path or repo command
  setup audit direction       setup reads nothing of the delegation layer
  setup audit deps            each tool dependencies.json names (installed FROM) is a discovered repo

Exit: 0 when nothing failed or drifted (needs-* lines are not failures), 1 on
drift or a failure, 2 when the path is refused or the usage is wrong; a refused
path has had nothing written. `audit content` and `audit deps` exit 3 when they could not run
(no sibling repos to compare against, as in a lone clone): UNCHECKED, never a
pass. A path named like a subcommand: pass ./<name>.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from setuplib import audit, core  # noqa: E402

SUBCOMMANDS = ["components", "plans", "audit"]


def cmd_components(_):
    spec = core.load_spec()
    for c in spec["components"]:
        print(f"  {c['name']:<8} {c['installs']}")
    print("one alone, on an existing repo: setup <path> --only <component>")
    print("statuses:")
    for k, v in spec["statuses"].items():
        print(f"  {k:<13} {v}")
    print("rebuild statuses (--node --rebuild, one line per file):")
    for k, v in spec["rebuild_statuses"].items():
        print(f"  {k:<13} {v}")
    hr = next(c for c in spec["components"] if c["name"] == "hooks")["rebuild"]
    print(f"hook files (one line per file that differed; --rebuild without --node overwrites only "
          f"a file the listing renders into a folder directly under {hr['scope_root']}/):")
    for part in ("kinds", "actions"):
        print(f"  {part}:")
        for k, v in hr[part].items():
            print(f"    {k:<12} {v}")
    return 0


def cmd_plans(args):
    if len(args) != 1:
        print("usage: setup plans <dir>", file=sys.stderr)
        return 2
    findings, note = audit.audit_plans(Path(args[0]))
    for f in findings:
        print(f"  FAIL  {f}")
    if not findings:
        print(f"  ok    {note}: every plan not done has a Setup component heading")
    return 1 if findings else 0


def cmd_audit(args):
    if args not in (["content"], ["direction"], ["deps"]):
        print("usage: setup audit content|direction|deps", file=sys.stderr)
        return 2
    fn = {"content": audit.audit_content, "direction": audit.audit_direction, "deps": audit.audit_deps}[args[0]]
    findings, note = fn()
    for f in findings:
        print(f"  FAIL  {f}")
    if findings:
        return 1
    if note.startswith("UNCHECKED"):
        print(f"  {note}")
        return 3  # could not run: never a pass
    print(f"  ok    {args[0]}: {note}")
    return 0


def cmd_setup(argv):
    p = argparse.ArgumentParser(prog="setup", add_help=False)
    p.add_argument("path")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--github", action="store_true")
    p.add_argument("--private", action="store_true")
    p.add_argument("--owner")
    p.add_argument("--name")
    p.add_argument("--hooks-from")
    p.add_argument("--plugins")
    p.add_argument("--user-scope")
    p.add_argument("--relative-to")
    p.add_argument("--checks")
    p.add_argument("--data-repo")
    p.add_argument("--node", action="store_true")
    p.add_argument("--rebuild", action="store_true")
    p.add_argument("--overwrite-uncommitted", action="store_true")
    p.add_argument("--only")
    p.add_argument("--json", action="store_true")
    try:
        a = p.parse_args(argv)
    except SystemExit:
        return 2
    names = [c["name"] for c in core.load_spec()["components"]]
    if a.only is not None and a.only not in names:
        print(f"setup: --only {a.only}: not a component (one of: {', '.join(names)})", file=sys.stderr)
        return 2
    if a.only and a.node:
        print("setup: --only runs one component of one repo: not with --node", file=sys.stderr)
        return 2
    if a.private and not a.github:
        print("setup: --private only means something with --github", file=sys.stderr)
        return 2
    hooks_rebuild = a.rebuild and not a.node  # without --node, --rebuild overwrites drifted hook copies
    if hooks_rebuild and a.only not in (None, "hooks"):
        print(f"setup: --rebuild without --node overwrites drifted hook copies: --only {a.only} renders none",
              file=sys.stderr)
        return 2
    if a.overwrite_uncommitted and not hooks_rebuild:
        print("setup: --overwrite-uncommitted only means something with --rebuild, without --node", file=sys.stderr)
        return 2
    rebuild_dry = a.dry_run
    if a.rebuild and a.node:
        a.dry_run = True  # a node rebuild writes only the generated files: the setup lines are a dry run's
    cwd = Path.cwd()
    dir_base = cwd / (a.relative_to or ".")
    if not dir_base.is_dir():
        print(f"setup: --relative-to {a.relative_to} is not a folder", file=sys.stderr)
        return 2
    target = (cwd / a.path).resolve()
    try:
        label = str(target.relative_to(cwd.resolve())) or "."
    except ValueError:
        label = str(target)
    s = core.Setup(target, label=label, name=a.name or target.name, dry_run=a.dry_run,
                   github=a.github, private=a.private, owner=a.owner,
                   hooks_from=a.hooks_from, plugins_from=a.plugins, user_scope_from=a.user_scope,
                   dir_base=dir_base, gh=os.environ.get("SETUP_GH", "gh"),
                   node=a.node, rebuild=a.rebuild and a.node, rebuild_dry=rebuild_dry, checks_cli=a.checks,
                   data_repo=data_repo(a.data_repo, cwd), only=a.only,
                   hooks_rebuild=hooks_rebuild, overwrite_uncommitted=a.overwrite_uncommitted)
    try:
        results = s.run()
    except core.Refused as e:
        print(f"setup: refused: {e}. Nothing was written.", file=sys.stderr)
        return 2
    counts = {}
    for r in results:
        counts[r.status] = counts.get(r.status, 0) + 1
    doc = core.tree_doc(label, results, s)
    if a.json:
        print(json.dumps({"dry_run": a.dry_run, **doc}))
    else:
        print_doc(doc, "")
        summary = ", ".join(f"{counts[k]} {k}" for k in core.PRECEDENCE if k in counts)
        how = (" (dry run, nothing written)" if rebuild_dry else
               " (rebuild: only generated files written)" if a.rebuild and a.node else
               " (rebuild: drifted hook copies overwritten)" if hooks_rebuild else "")
        print(f"setup {label}{how}: {summary}")
    return 0 if doc["ok"] else 1


def data_repo(flag, cwd):
    """The data repo's root: --data-repo, else $DATA_REPO (the instance's loader
    exports it; setup reads no instance file), resolved against the working folder.
    None when neither is set (an empty value is unset)."""
    key = next(c["key"] for c in core.load_spec()["components"] if c["name"] == "data")
    value = flag or os.environ.get(key) or None
    return (cwd / value).resolve() if value else None


def print_doc(doc, pad):
    for r in doc["results"]:
        print(f"{pad}  {r['component']:<8} {r['status']:<13} {r['detail']}")
    for x in doc.get("rebuild", []):
        print(f"{pad}    {x['status']:<12} {x['path']}  {x['detail']}")
    lines = doc.get("hook_files", [])
    missing = [x for x in lines if x["kind"] == "missing" and x["action"] == "installed"]
    if len(missing) > 3:  # a new repo's whole render: one line, not one per file (--json lists each)
        print(f"{pad}    hooks installed  {len(missing)} files (missing){'; dry run, not written' if missing[0]['detail'] else ''}"
              " (--json lists each)")
        lines = [x for x in lines if x not in missing]
    for x in lines:
        detail = f": {x['detail']}" if x["detail"] else ""
        print(f"{pad}    hooks {x['action']:<10} {x['path']}  ({x['kind']}{detail})")
    for kid in doc.get("children", []):
        print(f"{pad}  child {kid['path']}: {'ok' if kid['ok'] else 'FAILED or drifted'}")
        print_doc(kid, pad + "    ")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if argv[0] in SUBCOMMANDS:
        return globals()["cmd_" + argv[0]](argv[1:])
    return cmd_setup(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
